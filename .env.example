# Local PostgreSQL credentials
DB_NAME=authdb
DB_USERNAME=auth
DB_PASSWORD=change-me

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 authorization client secret (Compose adds the {noop} encoder prefix)
OAUTH2_CLIENT_SECRET=replace-with-a-client-secret

# Browser-facing URLs
GATEWAY_URL=http://localhost:8000
AUTH_ISSUER_URI=http://localhost:8000
OAUTH2_REDIRECT_URI=http://localhost:8000/login/oauth2/code/base-auth-client
REDIRECT_PATH=/
AUTH_COOKIE_SECURE=false
